---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
const {
  title = "Portfolio",
  description = "A portfolio showcasing interactive web projects built with Astro and GSAP.",
} = Astro.props;
const keyword=[
  "Astro Portfolio",
  "GSAP Animations",
  "Interactive Web Design",
  "Astro Developer",
  "Web Development Projects",
]
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keyword.join(", ")} />
  </head>
  <body>
    <Navbar />
    <slot />

    <!-- ─── FOOTER CTA ────────────────────────────────────────── -->
    <section class="cta" data-cta>
      <p class="cta-label">Have a project in mind?</p>
      <a href="/contact" class="cta-link">Let's talk →</a>
    </section>
    <style is:global>
      :root {
        --bg: #0f172a;
        --text: #f8fafc;
        --card-bg: #1e293b;
      }
      [data-theme="light"] {
        --bg: #f8fafc;
        --text: #0f172a;
        --card-bg: #e2e8f0;
      }
      body {
        background-color: var(--bg);
        color: var(--text);
        transition: none; /* Let GSAP handle the transition */
        font-family: sans-serif;
      }
      /* ── CTA ── */
      .cta {
        padding: 5rem 4rem 7rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border-top: 1px solid var(--border);
        opacity: 0;
        transform: translateY(20px);
      }

      .cta-label {
        font-family: var(--font-body);
        font-size: 0.72rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0;
      }

      .cta-link {
        font-family: var(--font-head);
        font-size: clamp(2.2rem, 5vw, 4.5rem);
        font-weight: 400;
        color: var(--text);
        text-decoration: none;
        transition:
          color 0.2s,
          letter-spacing 0.3s;
        display: inline-block;
      }

      .cta-link:hover {
        color: var(--accent);
        letter-spacing: 0.03em;
      }
    </style>
    <script>
      import { gsap } from "gsap";

      // ── CTA ────────────────────────────────────────────────────
      gsap.to("[data-cta]", {
        scrollTrigger: { trigger: "[data-cta]", start: "top 85%", once: true },
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: "power2.out",
      });
    </script>
  </body>
</html>
