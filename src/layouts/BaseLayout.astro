---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Jsonld from "../components/Jsonld.astro";
import { fullName, companyName, workType,subtitle,siteURL } from "../lib/consts";

const {
  title = {workType},
  description ={subtitle}
} = Astro.props;
const keyword = [
  "Astro Portfolio",
  "GSAP Animations",
  "Interactive Web Design",
  "Astro Developer",
  "Web Development Projects",
];
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImage = "../images/og-image.png";
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keyword.join(", ")} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.url)} />
  </head>
  <body>
    <Navbar />
    <Jsonld
      type="Person"
      data={{
        name: fullName,
        jobTitle: workType,
        worksFor: {
          "@type": "Organization",
          name: companyName,
        },
      }}
    />
    <slot />

    <!-- ─── FOOTER CTA ────────────────────────────────────────── -->
    <section class="cta" data-cta>
      <p class="cta-label">Have a project in mind?</p>
      <a href="/contact" class="cta-link">Let's talk →</a>
    </section>
    <style is:global>
      :root {
        --bg: #0f172a;
        --text: #f8fafc;
        --card-bg: #1e293b;
      }
      [data-theme="light"] {
        --bg: #f8fafc;
        --text: #0f172a;
        --card-bg: #e2e8f0;
      }
      body {
        background-color: var(--bg);
        color: var(--text);
        transition: none; /* Let GSAP handle the transition */
        font-family: sans-serif;
      }
      /* ── CTA ── */
      .cta {
        padding: 5rem 4rem 7rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        border-top: 1px solid var(--border);
        opacity: 0;
        transform: translateY(20px);
      }

      .cta-label {
        font-family: var(--font-body);
        font-size: 0.72rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0;
      }

      .cta-link {
        font-family: var(--font-head);
        font-size: clamp(2.2rem, 5vw, 4.5rem);
        font-weight: 400;
        color: var(--text);
        text-decoration: none;
        transition:
          color 0.2s,
          letter-spacing 0.3s;
        display: inline-block;
      }

      .cta-link:hover {
        color: var(--accent);
        letter-spacing: 0.03em;
      }
    </style>
    <script>
      import { gsap } from "gsap";

      // ── CTA ────────────────────────────────────────────────────
      gsap.to("[data-cta]", {
        scrollTrigger: { trigger: "[data-cta]", start: "top 85%", once: true },
        opacity: 1,
        y: 0,
        duration: 0.7,
        ease: "power2.out",
      });
    </script>
  </body>
</html>
